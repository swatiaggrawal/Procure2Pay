# Copy to .env for local use, or set these in the Render dashboard. All are optional.
DATABASE_URL=sqlite:///./p2p.db      # postgres://user:pass@host/db on Render
DEMO_MODE=1                          # 0 hides quick-login buttons and the API docs
MAX_UPLOAD_MB=5
BCRYPT_ROUNDS=10
SESSION_HOURS=12                     # absolute session lifetime
IDLE_HOURS=4                         # logged out after this long idle
STUCK_DAYS=2
MATCH_TOLERANCE_PCT=2                # three-way match tolerance
